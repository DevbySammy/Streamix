{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamix",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
  "nodejs_compat"
],
  "main": "./worker/index.ts",

"observability": {
  "enabled": true,
  "head_sampling_rate": 1,
  "logs": {
    "enabled": true,
    "head_sampling_rate": 1,
    "persist": true,
    "invocation_logs": true
  },
  "traces": {
    "enabled": false,
    "persist": true,
    "head_sampling_rate": 1
  }
},

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamix-db",
      "database_id": "59b0428d-a30d-459b-959c-b10f3fda31a4"
    }
  ],

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
